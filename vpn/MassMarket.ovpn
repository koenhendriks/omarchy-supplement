client
dev tun

# NetworkManager: remote=[2a0b:8f80:1:0:5054:ff:fe81:6572]:11956:udp6, 185.109.220.5:11956:udp
remote 2a0b:8f80:1:0:5054:ff:fe81:6572 11956 udp6
remote 185.109.220.5 11956 udp
remote-random
connect-timeout 4
resolv-retry infinite
nobind

persist-key
persist-tun

# Paths are relative to this file's directory; install-vpn.sh cd's here before
# importing, and openvpn3 inlines these into the stored profile at import time.
ca certs/MassMarket-ca.pem
cert certs/MassMarket-cert.pem
key certs/MassMarket-key.pem
tls-auth certs/MassMarket-tls-auth.pem 1
remote-cert-tls server

# connection-type=password-tls. MassMarket.auth is rendered from .env by
# install-vpn.sh, read once at import time, then deleted.
auth-user-pass MassMarket.auth

auth SHA1
cipher AES-128-CBC
data-ciphers AES-128-CBC
data-ciphers-fallback AES-128-CBC
comp-lzo no
# The server pushes compression, which openvpn3 rejects by default. An in-file
# allow-compression is ignored, so install-vpn.sh sets it as a profile override.

ping 10
ping-restart 60
reneg-sec 2592000
push-peer-info

# ipv4/ipv6 never-default=true ("Use this connection only for resources on its
# network"): drop any pushed default route, keep the pushed split-tunnel routes
pull-filter ignore "redirect-gateway"
pull-filter ignore "route 0.0.0.0 0.0.0.0"
pull-filter ignore "route-ipv6 ::/0"

verb 3
