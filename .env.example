# Copy to .env and fill in the real values.
# Consumed by install-vpn.sh.

# MassMarket (OpenVPN, imported into openvpn3)
VPN_MASSMARKET_USERNAME=
VPN_MASSMARKET_PASSWORD=

# Sandwave (IKEv2/IPsec via strongSwan, NOT OpenVPN -- see vpn/README)
# EAP identity and password; password-flags=0 means it was stored, not prompted.
VPN_SANDWAVE_USERNAME=
VPN_SANDWAVE_PASSWORD=
