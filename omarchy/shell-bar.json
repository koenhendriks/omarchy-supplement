{
  "centerAnchor": "omarchy.active-window",
  "maxWidth": 2560,
  "layout": {
    "left": [
      {
        "id": "omarchy.menu"
      },
      {
        "id": "omarchy.workspaces"
      },
      {
        "id": "omarchy.media"
      }
    ],
    "center": [
      {
        "id": "omarchy.indicators"
      },
      {
        "id": "omarchy.active-window"
      },
      {
        "id": "omarchy.weather"
      },
      {
        "id": "omarchy.system-update"
      },
      {
        "id": "omarchy.keyboard-layout"
      }
    ],
    "right": [
      {
        "id": "omarchy.tray"
      },
      {
        "id": "vpn-mass",
        "type": "command",
        "exec": "~/.config/omarchy/bar/scripts/vpn status MassMarket",
        "interval": 5,
        "onClick": "~/.config/omarchy/bar/scripts/vpn toggle MassMarket",
        "tooltip": "MassMarket VPN - click to toggle"
      },
      {
        "id": "vpn-sand",
        "type": "command",
        "exec": "~/.config/omarchy/bar/scripts/vpn status Sandwave",
        "interval": 5,
        "onClick": "~/.config/omarchy/bar/scripts/vpn toggle Sandwave",
        "tooltip": "Sandwave VPN - click to toggle"
      },
      {
        "id": "omarchy.agents"
      },
      {
        "id": "omarchy.bluetooth"
      },
      {
        "id": "omarchy.network"
      },
      {
        "id": "omarchy.audio"
      },
      {
        "id": "omarchy.monitor"
      },
      {
        "id": "cpu",
        "type": "command",
        "exec": "~/.config/omarchy/bar/scripts/cpu",
        "interval": 5
      },
      {
        "id": "shavanced.notification-center"
      },
      {
        "id": "omarchy.power"
      },
      {
        "id": "@user@.clock",
        "format": "dddd HH:mm",
        "formatAlt": "d MMMM 'W'ww yyyy",
        "verticalFormat": "HH\n—\nmm",
        "centerOnBar": false
      }
    ]
  }
}
